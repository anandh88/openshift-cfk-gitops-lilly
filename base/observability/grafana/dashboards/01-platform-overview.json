{
  "uid": "platform-overview",
  "title": "01 - Streaming Platform Overview",
  "description": "NOC/SRE landing page - is the streaming platform healthy? All panels use metrics confirmed live on this cluster (see docs/prometheus-metrics-guide.md). Flink/SQL Server panels are intentionally absent - see docs/observability-architecture.md for why (no Flink Prometheus endpoint / no in-cluster SQL Server yet).",
  "tags": [
    "platform",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Brokers Up",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"kafka\"} == 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Kafka brokers currently scrapeable",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Active Controllers",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
