    {
      "title": "Brokers Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"kafka\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "WHAT: Kafka broker pods currently scrapeable.\nWHY: The most basic cluster-health signal.\nNORMAL: 3 (this deployment runs 3 brokers)\nPROBLEM: < 3\nNEXT: 02 - Kafka Platform dashboard.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 4,
        "h": 4
      }
    },
    {
      "title": "Active Controllers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_controller_kafkacontroller_value{name=\"ActiveControllerCount\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "WHAT: KRaft active controller count.\nWHY: Exactly one controller must be active for the metadata quorum to make progress.\nNORMAL: 1\nPROBLEM: 0 or >1\nNEXT: 02 - Kafka Platform -> KRaft Controller row.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
