    {
      "title": "Request latency (mean ms): Produce / FetchConsumer",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kafka_network_requestmetrics_mean{name=\"TotalTimeMs\", request=~\"Produce|FetchConsumer\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{request}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "WHAT: Mean end-to-end request time.\nWHY: Latency golden signal.\nNORMAL: Single-digit to low tens of ms on a lab cluster\nPROBLEM: Climbing sustained latency\nNEXT: 02 - Kafka Platform -> Broker Request Latency Breakdown row.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
