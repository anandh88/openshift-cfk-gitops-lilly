    {
      "title": "Cluster throughput (bytes/sec)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_server_brokertopicmetrics_count{name=\"BytesInPerSec\"}[5m]))",
          "refId": "A",
          "legendFormat": "bytes in"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_server_brokertopicmetrics_count{name=\"BytesOutPerSec\"}[5m]))",
          "refId": "B",
          "legendFormat": "bytes out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "description": "WHAT: Cluster-wide produce/fetch byte rate.\nWHY: Traffic golden signal for Kafka.\nNORMAL: Matches expected workload volume\nPROBLEM: Unexpected drop to zero or spike\nNEXT: Dashboard 3 -> Kafka Topics row for per-topic breakdown.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
